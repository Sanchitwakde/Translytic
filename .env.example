# Copy this file to .env and paste your own OpenRouter API key.
# Get a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Free model router: automatically selects an available free model.
# You can replace this with a currently available model ID ending in :free.
OPENROUTER_MODEL=google/gemma-4-31b-it:free